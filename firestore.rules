rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Comptes : tout membre connecté peut lire, chacun ne modifie que le sien.
    match /accounts/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Données du jeu partagées entre membres connectés.
    match /punches/{id} { allow read, write: if request.auth != null; }
    match /players/{id} { allow read, write: if request.auth != null; }
    match /raids/{id}   { allow read, write: if request.auth != null; }
    match /fights/{id}  { allow read, write: if request.auth != null; }
    match /chat/{id}    { allow read, delete: if request.auth != null; allow create: if request.auth != null && request.resource.data.t is string && request.resource.data.t.size() <= 280; }
  }
}
